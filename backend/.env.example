# Configuración de la API InstaYa!
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instaya?schema=public"
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"

# Opcional: con una clave de Anthropic, el asistente de reposicion redacta su resumen con un LLM.
# Sin clave funciona igual, con un resumen generado por reglas.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-5-5"

# Operador de la plataforma (dueño del SaaS): con esta clave en el header x-platform-key
# se listan las empresas y se activa el plan Básico cuando el cliente paga. Vacía = desactivado.
# PLATFORM_KEY=""
# Contacto que ve el cliente para pagar o pedir soporte
# SOPORTE_CONTACTO="soporte@instaya.app"
