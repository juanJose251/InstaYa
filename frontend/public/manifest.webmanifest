{
  "name": "InstaYa! — Inventario para tu negocio",
  "short_name": "InstaYa!",
  "description": "Inventario, ventas y alertas de stock para PYMES, desde el celular.",
  "lang": "es-SV",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1565c0",
  "theme_color": "#1565c0",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Nueva venta", "url": "/app/ventas", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Productos", "url": "/app/productos", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
